# ── Neon Postgres (get from neon.tech dashboard) ──────────────────────────────
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/wandermate?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.neon.tech/wandermate?sslmode=require"

# ── Razorpay (get from razorpay.com/dashboard → Settings → API Keys) ──────────
RAZORPAY_KEY_ID="rzp_live_XXXXXXXXXXXX"
RAZORPAY_KEY_SECRET="XXXXXXXXXXXXXXXXXXXXXXXX"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# ── Public (safe to expose to browser) ────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_XXXXXXXXXXXX"
NEXT_PUBLIC_WHATSAPP_BOOKING_NUMBER="919XXXXXXXXX"   # e.g. 919876543210

# ── Email confirmations (resend.com — free tier available) ─────────────────────
RESEND_API_KEY="re_XXXXXXXXXXXXXXXXXXXXXXXX"
BOOKING_FROM_EMAIL="WanderMate <bookings@wandermate.in>"   # must be a verified domain in Resend

# ── Test pricing (remove before going live!) ───────────────────────────────────
# When set, every package totals this amount — add-ons are ₹0 in test mode.
NEXT_PUBLIC_TEST_BOOKING_PRICE="1"
